<FilesMatch "^\.env(?:\..*)?$">
    Require all denied
</FilesMatch>

<FilesMatch "(?i)^(?:\.git.*|composer\.(?:json|lock)|SETUP\.md|starter\.py|router\.php)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule "(?i)(?:^|/)(?:vendor|database|tests)(?:/|$)" - [F,L]
    RewriteRule "(?i)(?:^|/)\.git[^/]*(?:/|$)" - [F,L]
</IfModule>
