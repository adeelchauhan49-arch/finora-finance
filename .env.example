APP_ENV=local
ALLOW_DEBUG_OTP=false
FINORA_PRO_ENABLED=false
FINORA_PRO_PROMO_CODE=

# Supabase hosted project configuration.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-publishable-key
SUPABASE_SITE_URL=http://localhost/Finance-AI/
# Server-only key for the one-time MySQL account/data import. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Use the PostgreSQL connection URL from Supabase Dashboard > Project Settings > Database.
# Keep its database password private on the server; never put this URL in frontend code.
SUPABASE_DB_URL=postgresql://postgres:your-database-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# One-time legacy MySQL source for scripts/migrate_mysql_to_supabase.php.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_NAME=finance_ai
LEGACY_DB_USER=root
LEGACY_DB_PASS=

# SMTP settings: use credentials and app passwords from your mail provider.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=Finora
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_FROM_NAME=Finora

# Keep this key private on the PHP server; never put it in frontend JavaScript.
JARVIS_API_KEY=
JARVIS_MODEL=gpt-4o